APP_NAME=examate-rag
ENVIRONMENT=local
# Add API keys here later. Never commit the real .env file.

# LLM provider (only "ollama" for now)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=60

# Cost per million tokens (0 for local models; set for hosted providers)
OLLAMA_INPUT_PRICE_PER_MILLION=0
OLLAMA_OUTPUT_PRICE_PER_MILLION=0
