APP_NAME=examate-rag
ENVIRONMENT=local

# LLM provider (only "ollama" for now)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=60

# Cost per million tokens (0 for local models; set for hosted providers)
OLLAMA_INPUT_PRICE_PER_MILLION=0
OLLAMA_OUTPUT_PRICE_PER_MILLION=0

# Usage database
USAGE_DB_PATH=./usage.db

# Database (Postgres + pgvector)
DATABASE_URL=postgresql://shiftwise:shiftwise@localhost:5432/shiftwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shiftwise
POSTGRES_PASSWORD=shiftwise
POSTGRES_DB=shiftwise
