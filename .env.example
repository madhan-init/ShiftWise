APP_NAME=examate-rag
ENVIRONMENT=local

# LLM provider ("gemini" | "ollama")
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=60

# Gemini settings (recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b
GEMINI_INPUT_PRICE_PER_MILLION=0.075
GEMINI_OUTPUT_PRICE_PER_MILLION=0.30

# Ollama settings (alternative local provider & embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768
CHUNK_PAGE_LINES=50
OLLAMA_INPUT_PRICE_PER_MILLION=0
OLLAMA_OUTPUT_PRICE_PER_MILLION=0

# Usage database
USAGE_DB_PATH=./usage.db

# Database (Postgres + pgvector)
DATABASE_URL=postgresql://shiftwise:shiftwise@localhost:5432/shiftwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shiftwise
POSTGRES_PASSWORD=shiftwise
POSTGRES_DB=shiftwise
